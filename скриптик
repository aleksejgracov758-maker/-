        end

        frameCount = 0
        elapsed = 0
    end
end)

-- Player lifecycle
local function setupPlayer(target)
    if target == player then
        return
    end

    target.CharacterAdded:Connect(function(character)
        task.wait(1)

        if espEnabled then
            local old = highlights[target]

            if old then
                old:Destroy()
            end

            local h = Instance.new("Highlight")
            h.Name = "NOVAHighlight"
            h.FillColor = Color3.fromRGB(100, 80, 255)
            h.OutlineColor = Color3.fromRGB(100, 220, 255)
            h.FillTransparency = 0.65
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee = character
            h.Parent = character

            highlights[target] = h
        end
    end)
end

for _, target in ipairs(Players:GetPlayers()) do
    setupPlayer(target)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(target)
    if highlights[target] then
        highlights[target]:Destroy()
        highlights[target] = nil
    end
end)

-- Dragging windows
local function makeDraggable(frame, handle)
    local dragging = false
    local dragStart
    local startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = frame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then

            local delta = input.Position - dragStart

            frame.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

makeDraggable(main, header)
makeDraggable(fpsFrame, fpsFrame)
makeDraggable(restore, restore)

