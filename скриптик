local frameCount = 0
local elapsed = 0

local fpsConnection = RunService.RenderStepped:Connect(function(dt)
    frameCount += 1
    elapsed += dt

    if elapsed >= 0.5 then
        local fps = math.round(frameCount / elapsed)

        fpsLabel.Text = "FPS: " .. fps

        if fps >= 55 then
            fpsLabel.TextColor3 = Color3.fromRGB(100, 230, 160)
        elseif fps >= 30 then
            fpsLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
