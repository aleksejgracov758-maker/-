-- ESP toggle
local espEnabled = false
local highlights = {}

local espButton = createButton(
    main,
    "ESP PLAYERS  [OFF]",
    UDim2.new(1, -24, 0, 40),
    UDim2.fromOffset(12, 65)
)

espButton.Activated:Connect(function()
    espEnabled = not espEnabled

    espButton.Text = "ESP PLAYERS  " ..
        (espEnabled and "[ON]" or "[OFF]")

    espButton.BackgroundColor3 = espEnabled
        and Color3.fromRGB(70, 60, 135)
        or Color3.fromRGB(43, 43, 64)

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player and target.Character then
            local highlight = highlights[target]

            if espEnabled then
                if not highlight or not highlight.Parent then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "NOVAHighlight"
                    highlight.FillColor = Color3.fromRGB(100, 80, 255)
                    highlight.OutlineColor = Color3.fromRGB(100, 220, 255)
                    highlight.FillTransparency = 0.65
                    highlight.DepthMode =
                        Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Adornee = target.Character
                    highlight.Parent = target.Character

                    highlights[target] = highlight
                else
                    highlight.Adornee = target.Character
                    highlight.Enabled = true
                end
            else
                if highlight then
                    highlight:Destroy()
                    highlights[target] = nil
                end
            end
        end
    end
end)

